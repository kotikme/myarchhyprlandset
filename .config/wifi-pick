#!/bin/bash

# ============================================
# Простой выбор Wi-Fi сети через меню с цифрами
# ============================================

# Принудительно сканируем сети
echo "🔍 Сканирую Wi-Fi сети..."
nmcli device wifi rescan 2>/dev/null
sleep 2

# Получаем список сетей в terse-формате
networks=$(nmcli -t -f SSID,SIGNAL,SECURITY device wifi list | sort -t: -k2 -nr -u)

# Проверяем, есть ли сети
if [ -z "$networks" ]; then
    echo "❌ Сети не найдены. Проверь, включён ли Wi-Fi."
    echo "Нажми Enter для выхода..."
    read
    exit 1
fi

# Выводим список с номерами
echo ""
echo "📶 Доступные Wi-Fi сети и уровень сигнала %:"
echo "----------------------------------------"

declare -a ssid_array

i=1
while IFS= read -r line; do
    ssid=$(echo "$line" | cut -d: -f1)
    signal=$(echo "$line" | cut -d: -f2)
    security=$(echo "$line" | cut -d: -f3)

    if [ -z "$ssid" ]; then
        continue
    fi

    ssid_array[$i]="$ssid"

    printf "%2d) %-30s [%s%%] %s\n" "$i" "$ssid" "$signal" "$security"
    i=$((i+1))
done <<< "$networks"

echo "----------------------------------------"
echo ""

# Просим выбрать номер
echo -n "Введи номер сети (или 0 для выхода): "
read choice

if [ "$choice" = "0" ] || [ -z "$choice" ]; then
    echo "Выход."
    exit 0
fi

selected_ssid="${ssid_array[$choice]}"

if [ -z "$selected_ssid" ]; then
    echo "❌ Неверный номер."
    echo "Нажми Enter для выхода..."
    read
    exit 1
fi

echo ""
echo "🔌 Подключаюсь к: $selected_ssid"
echo ""

# Спрашиваем пароль скрыто (как у root)
echo -n "Введите пароль: "
read -s password
echo ""  # перенос строки после скрытого ввода

# Подключаемся
if [ -z "$password" ]; then
    # Если пароль пустой — пробуем без него (открытая сеть)
    nmcli device wifi connect "$selected_ssid"
else
    nmcli device wifi connect "$selected_ssid" password "$password"
fi

echo ""
echo "Нажми Enter для выхода..."
read
