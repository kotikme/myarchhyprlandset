{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,
    "modules-left": ["hyprland/workspaces", "custom/language"],
    "modules-center": [],
    "modules-right": [
        "custom/wallpaper",
        "cpu",
        "memory",
        "disk",
        "temperature",
        "backlight",
        "battery",
        "pulseaudio",
        "custom/wifi",
        "network",
        "clock"
    ],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate"
    },

    "custom/language": {
        "format": "{}",
        "exec": "hyprctl devices -j | jq -r '.keyboards[] | select(.main == true) | .active_keymap' | cut -c1-2 | tr 'a-z' 'A-Z'",
        "interval": 1,
        "tooltip": false
    },

    "custom/wallpaper": {
        "format": "[WPPR]",
        "on-click": "~/.config/waybar/scripts/wallpaper-picker.sh",
        "tooltip": false
    },

    "custom/wifi": {
        "format": "📶",
        "on-click": "kitty -e ~/.config/waybar/scripts/wifi-pick",
        "tooltip": true,
        "tooltip-format": "Нажми, чтобы выбрать Wi-Fi сеть"
    },

    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2,
        "tooltip": true,
        "on-click": "kitty -e ~/.config/waybar/scripts/cpu-menu.sh"
    },
    
    "memory": {
        "format": "RAM {}%",
        "interval": 5,
        "tooltip": true
    },

    "disk": {
        "format": "{free} GB",
        "interval": 30,
        "path": "/",
        "tooltip": true
    },

    "temperature": {
        "format": "🌡️ {temperatureC}°C",
        "interval": 5,
        "critical-threshold": 75,
        "tooltip": true
    },

    "backlight": {
        "format": "☀️ {percent}%",
        "interval": 2,
        "tooltip": true
    },

    "battery": {
        "format": "🔋 {capacity}%",
        "format-charging": "⚡ {capacity}%",
        "format-full": "🔌 {capacity}%",
        "interval": 30,
        "tooltip": true,
        "tooltip-format": "🔋 {capacity}%\nОсталось: {time}",
        "on-click": "kitty -e ~/.config/waybar/scripts/battery-menu.sh"
    },

    "pulseaudio": {
        "format": "🔊 {volume}%",
        "format-muted": "🔇 MUTE",
        "on-click": "pavucontrol",
        "tooltip": true
    },

    "network": {
        "format": "{essid}",
        "format-disconnected": "❌ Offline",
        "tooltip-format": "{ifname} {ipaddr}",
        "interval": 5
    },

    "clock": {
        "format": "{:%H:%M}",
        "interval": 60,
        "tooltip": true
    }
}