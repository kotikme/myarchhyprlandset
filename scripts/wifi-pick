#!/bin/bash

echo "🔍 Сканирую Wi-Fi сети..."
nmcli device wifi rescan 2>/dev/null
sleep 2

networks=$(nmcli -t -f SSID,SIGNAL,SECURITY device wifi list | sort -t: -k2 -nr -u)

if [ -z "$networks" ]; then
    echo "❌ Сети не найдены. Проверь, включён ли Wi-Fi."
    echo "Нажми Enter для выхода..."
    read
    exit 1
fi

echo ""
echo "📶 Доступные Wi-Fi сети:"
echo "----------------------------------------"
echo " #  СЕТЬ                           СИГНАЛ  ЗАЩИТА"
echo "----------------------------------------"

declare -a ssid_array

i=1
while IFS= read -r line; do
    ssid=$(echo "$line" | cut -d: -f1)
    signal=$(echo "$line" | cut -d: -f2)
    security=$(echo "$line" | cut -d: -f3)

    if [ -z "$ssid" ]; then
        continue
    fi

    if [ "$security" = "--" ] || [ -z "$security" ]; then
        lock_icon="🔓 Открыт"
    else
        lock_icon="🔒 $security"
    fi

    ssid_array[$i]="$ssid"

    printf "%2d) %-30s [%3s%%] %s\n" "$i" "$ssid" "$signal" "$lock_icon"
    i=$((i+1))
done <<< "$networks"

echo "----------------------------------------"
echo ""

echo -n "Введи номер сети (или 0 для выхода): "
read choice

if [ "$choice" = "0" ] || [ -z "$choice" ]; then
    echo "Выход."
    exit 0
fi

selected_ssid="${ssid_array[$choice]}"

if [ -z "$selected_ssid" ]; then
    echo "❌ Неверный номер."
    echo "Нажми Enter для выхода..."
    read
    exit 1
fi

echo ""
echo "🔌 Подключаюсь к: $selected_ssid"
echo ""

echo -n "Введи пароль (не будет видно): "
read -s password
echo ""

if [ -z "$password" ]; then
    nmcli device wifi connect "$selected_ssid"
else
    nmcli device wifi connect "$selected_ssid" password "$password"
fi

echo ""
echo "Нажми Enter для выхода..."
read